## PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_SSL=false
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# Make sure to use the strong password, the following value is added as an example
POSTGRES_PASSWORD=mysecretpassword

## Admin Backend
DRILL_ADMIN_BACKEND_VERSION=0.11.2
DRILL_DB_NAME=drill
DRILL_DB_MAX_POOL_SIZE=50
# Name of the dedicated database used to store metrics. This database is created by the Postgres initialization scripts (see "db-init").
DRILL_METRICS_DB_NAME=drill-metrics
DRILL_METRICS_DB_MAX_POOL_SIZE=50
# ETL settings
DRILL_SCHEDULER_ETL_JOB_CRON=0 * * * * ?
DRILL_ETL_MAX_WORKERS=4
DRILL_ETL_CONSISTENCY_WINDOW=0
DRILL_ETL_PROCESSING_DELAY=0
DRILL_ETL_BATCH_SIZE=1000
DRILL_ETL_BUFFER_SIZE=100000
DRILL_ETL_FETCH_SIZE=100000
DRILL_ETL_EXTRACTION_LIMIT=1000000
DRILL_ETL_AGGREGATION_BUFFER_SIZE=50000

## Admin UI
DRILL_UI_VERSION=0.11.2